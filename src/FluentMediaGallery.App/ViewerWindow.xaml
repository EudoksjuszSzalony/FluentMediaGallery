<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentMediaGallery.App.ViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentMediaGallery — Podgląd">
    <Grid x:Name="ViewerRoot" Background="#101114">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
            <RowDefinition x:Name="FilmstripRow" Height="112"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#222428" Padding="12,5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← Galeria" Click="Close_Click"/>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock x:Name="FileTitle" Text="Podgląd" Foreground="White"
                           FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ContextTitle" Text="Wczytywanie..."
                           Foreground="#B7BEC7" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="FavoriteButton" Click="Favorite_Click"
                    Content="♡ Ulubione (L)" IsEnabled="False"/>
            <Button Grid.Column="3" x:Name="FilmstripButton" Click="FilmstripToggle_Click"
                    Content="Ukryj pasek (F)"/>
            <Button Grid.Column="4" Content="✕" Click="Close_Click"
                    ToolTipService.ToolTip="Zamknij podgląd (Esc)"/>
        </Grid>

        <Grid Grid.Row="1" x:Name="PhotoSurface" Background="#101114">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Dodaj/usuń z ulubionych (L)" Click="Favorite_Click"/>
                    <MenuFlyoutItem Text="Pokaż/ukryj pasek miniaturek (F)" Click="FilmstripToggle_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Dopasuj do okna (Ctrl+Num 0)" Click="ZoomFit_Click"/>
                    <MenuFlyoutItem Text="Powiększ (Ctrl+Num +)" Click="ZoomIn_Click"/>
                    <MenuFlyoutItem Text="Pomniejsz (Ctrl+Num -)" Click="ZoomOut_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Otwórz lokalizację w Eksploratorze" Click="Explorer_Click"/>
                    <MenuFlyoutItem Text="Kopiuj ścieżkę" Click="CopyPath_Click"/>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="1" x:Name="ZoomScroll" Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="5"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ViewChanged="ZoomScroll_ViewChanged">
                <Image x:Name="FullImage" Stretch="Fill"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ScrollViewer>
            <ProgressRing Grid.Column="1" x:Name="LoadingIndicator" Width="52" Height="52"
                          IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="ImageMessage" Foreground="White" FontSize="13"
                       TextAlignment="Center" TextWrapping="Wrap"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Margin="20" MaxWidth="800"/>
            <Button x:Name="PreviousButton" Grid.Column="0" Content="❮" FontSize="25"
                    Opacity="0" BorderThickness="0" Background="#333333"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    PointerEntered="PreviousPointerEntered" PointerExited="PreviousPointerExited"
                    Click="Previous_Click"/>
            <Button x:Name="NextButton" Grid.Column="2" Content="❯" FontSize="25"
                    Opacity="0" BorderThickness="0" Background="#333333"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    PointerEntered="NextPointerEntered" PointerExited="NextPointerExited"
                    Click="Next_Click"/>
        </Grid>

        <Grid Grid.Row="2" Background="#202226" Padding="12,3" ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="−" FontSize="18" Click="ZoomOut_Click"
                    AutomationProperties.Name="Pomniejsz"/>
            <TextBlock Grid.Column="1" x:Name="ZoomLabel" Text="100%"
                       FontSize="12" Foreground="White" Width="45"
                       VerticalAlignment="Center" TextAlignment="Center"/>
            <Slider Grid.Column="2" x:Name="ZoomSlider" Minimum="25" Maximum="500"
                    StepFrequency="5" Value="100" VerticalAlignment="Center"
                    ValueChanged="ZoomSlider_ValueChanged"
                    AutomationProperties.Name="Powiększenie zdjęcia"/>
            <TextBlock Grid.Column="3" x:Name="Status" Text=""
                       Foreground="#B7BEC7" VerticalAlignment="Center" FontSize="11"
                       TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
            <Button Grid.Column="4" Content="+" FontSize="18" Click="ZoomIn_Click"
                    AutomationProperties.Name="Powiększ"/>
        </Grid>

        <Border Grid.Row="3" x:Name="FilmstripBorder" Background="#202226"
                Padding="9,6">
            <Grid>
                <ListView x:Name="Filmstrip" Height="92" SelectionMode="Single"
                          SelectionChanged="Filmstrip_SelectionChanged"
                          ContainerContentChanging="Filmstrip_ContainerContentChanging"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="104" Height="78" Margin="2">
                                <Border Background="#32353A" CornerRadius="6"/>
                                <Image Source="{Binding Thumbnail}" Width="100" Height="75"
                                       Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding TypeMark}" HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" Foreground="White" Margin="4"/>
                                <TextBlock Text="{Binding Heart}" HorizontalAlignment="Right"
                                           VerticalAlignment="Top" Foreground="IndianRed" Margin="3"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="▾" Click="FilmstripToggle_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="32" Height="25" Padding="0" Opacity="0.5"
                        ToolTipService.ToolTip="Ukryj pasek miniaturek (F)"/>
            </Grid>
        </Border>
    </Grid>
</Window>
