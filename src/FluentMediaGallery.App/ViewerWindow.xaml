<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentMediaGallery.App.ViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentMediaGallery — Podgląd">
    <Grid x:Name="ViewerRoot" Background="#101114">
        <Grid.RowDefinitions>
            <RowDefinition Height="31"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
            <RowDefinition x:Name="FilmstripRow" Height="90"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleDragRegion" Grid.Row="0" Background="#202226" Padding="12,0,155,0">
            <TextBlock Text="FluentMediaGallery" Foreground="#AEB6C0" FontSize="11"
                       VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" Background="#222428" Padding="9,2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← Galeria" Click="Close_Click"/>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock x:Name="FileTitle" Text="Podgląd" Foreground="White"
                           FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ContextTitle" Text="Wczytywanie..."
                           Foreground="#B7BEC7" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="FavoriteButton" Click="Favorite_Click"
                    Content="♡ Ulubione (L)" IsEnabled="False"/>
            <Button Grid.Column="3" x:Name="FilmstripButton" Click="FilmstripToggle_Click"
                    Content="Ukryj pasek (F)"/>
            <Button Grid.Column="4" Content="✕" Click="Close_Click"
                    ToolTipService.ToolTip="Zamknij podgląd (Esc)"/>
        </Grid>

        <Grid Grid.Row="2" x:Name="PhotoSurface" Background="#101114"
              SizeChanged="PhotoSurface_SizeChanged">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Dodaj/usuń z ulubionych (L)" Click="Favorite_Click"/>
                    <MenuFlyoutItem Text="Pokaż/ukryj pasek miniaturek (F)" Click="FilmstripToggle_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Dopasuj do okna (Ctrl+Num 0)" Click="ZoomFit_Click"/>
                    <MenuFlyoutItem Text="Powiększ (Ctrl+Num +)" Click="ZoomIn_Click"/>
                    <MenuFlyoutItem Text="Pomniejsz (Ctrl+Num -)" Click="ZoomOut_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Otwórz lokalizację w Eksploratorze" Click="Explorer_Click"/>
                    <MenuFlyoutItem Text="Kopiuj ścieżkę" Click="CopyPath_Click"/>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="1" x:Name="ZoomScroll" Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="5"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ViewChanged="ZoomScroll_ViewChanged">
                <Image x:Name="FullImage" Stretch="Fill"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ScrollViewer>
            <ProgressRing Grid.Column="1" x:Name="LoadingIndicator" Width="52" Height="52"
                          IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="ImageMessage" Foreground="White" FontSize="13"
                       TextAlignment="Center" TextWrapping="Wrap"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Margin="20" MaxWidth="800"/>
            <Grid Grid.Column="0" Background="Transparent"
                  PointerEntered="PreviousPointerEntered" PointerExited="PreviousPointerExited">
                <Button x:Name="PreviousButton" Content="❮" FontSize="18"
                        Width="34" Height="50" Opacity="0" CornerRadius="7"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="Previous_Click"/>
            </Grid>
            <Grid Grid.Column="2" Background="Transparent"
                  PointerEntered="NextPointerEntered" PointerExited="NextPointerExited">
                <Button x:Name="NextButton" Content="❯" FontSize="18"
                        Width="34" Height="50" Opacity="0" CornerRadius="7"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="Next_Click"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Background="#202226" Padding="10,2" ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="Status" Text=""
                       Foreground="#A9B4BF" VerticalAlignment="Center" FontSize="10"
                       TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
            <Button Grid.Column="1" x:Name="ZoomModeButton" Content="Dopasuj"
                    Click="ZoomModeButton_Click" Padding="8,3"
                    ToolTipService.ToolTip="Przełącz między dopasowaniem do okna i 100% oryginału"/>
            <Button Grid.Column="2" Content="−" FontSize="17" Click="ZoomOut_Click" Padding="7,0"/>
            <TextBlock Grid.Column="3" x:Name="ZoomLabel" Text="—"
                       FontSize="11" Foreground="White" Width="48"
                       VerticalAlignment="Center" TextAlignment="Center"/>
            <Slider Grid.Column="4" x:Name="ZoomSlider" Minimum="5" Maximum="500"
                    StepFrequency="1" Value="100" VerticalAlignment="Center"
                    ValueChanged="ZoomSlider_ValueChanged"
                    AutomationProperties.Name="Powiększenie w procentach oryginalnego obrazu"/>
            <Button Grid.Column="5" Content="+" FontSize="17" Click="ZoomIn_Click" Padding="7,0"/>
        </Grid>

        <Border Grid.Row="4" x:Name="FilmstripBorder" Background="#202226"
                Padding="5,2">
            <Grid>
                <ListView x:Name="Filmstrip" Height="82" SelectionMode="Single"
                          SelectionChanged="Filmstrip_SelectionChanged"
                          ContainerContentChanging="Filmstrip_ContainerContentChanging"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="86" Height="75" Margin="1">
                                <Border Background="#32353A" CornerRadius="6"/>
                                <Image Source="{Binding Thumbnail}" Width="84" Height="73"
                                       Stretch="UniformToFill"/>
                                <Border Width="3" Background="#48BFFF" Opacity="{Binding SelectionOpacity}"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
                                <TextBlock Text="{Binding TypeMark}" HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" Foreground="White" Margin="4"/>
                                <TextBlock Text="{Binding Heart}" HorizontalAlignment="Right"
                                           VerticalAlignment="Top" Foreground="IndianRed" Margin="3"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="▾" Click="FilmstripToggle_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="32" Height="25" Padding="0" Opacity="0.5"
                        ToolTipService.ToolTip="Ukryj pasek miniaturek (F)"/>
            </Grid>
        </Border>
    </Grid>
</Window>
