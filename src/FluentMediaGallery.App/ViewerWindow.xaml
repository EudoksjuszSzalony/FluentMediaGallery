<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentMediaGallery.App.ViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentMediaGallery — Podgląd">
    <Grid x:Name="ViewerRoot" Background="#101114">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="FilmstripRow" Height="90"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <!-- One Photos-like title/toolbar; reserve 144 DIP for system caption buttons. -->
        <Grid Grid.Row="0" Background="#202226" ColumnSpacing="5" Padding="5,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="144"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← Galeria" Click="Close_Click"
                    Padding="9,3" Height="30" FontSize="12"/>
            <Grid x:Name="TitleDragRegion" Grid.Column="1"
                  Background="Transparent" Padding="8,0">
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock x:Name="FileTitle" Text="Podgląd" Foreground="White"
                               FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ContextTitle" Text="Wczytywanie..."
                               Foreground="#A9B3BC" FontSize="10"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
            <Button Grid.Column="2" x:Name="FavoriteButton" Click="Favorite_Click"
                    Content="♡ Ulubione (L)" IsEnabled="False" Height="30"
                    Padding="10,2" FontSize="11"/>
            <Button Grid.Column="3" x:Name="FilmstripButton" Click="FilmstripToggle_Click"
                    Content="Pasek (F)" Height="30" Padding="10,2" FontSize="11"/>
            <Button Grid.Column="4" x:Name="DetailsButton" Click="DetailsToggle_Click"
                    Content="ⓘ Szczegóły" Height="30" Padding="10,2" FontSize="11"/>
        </Grid>

        <Grid Grid.Row="1" x:Name="PhotoSurface" Background="#101114"
              SizeChanged="PhotoSurface_SizeChanged">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Dodaj/usuń z ulubionych (L)" Click="Favorite_Click"/>
                    <MenuFlyoutItem Text="Pokaż/ukryj pasek miniaturek (F)" Click="FilmstripToggle_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Dopasuj do okna (Ctrl+Num 0)" Click="ZoomFit_Click"/>
                    <MenuFlyoutItem Text="Powiększ (Ctrl+Num +)" Click="ZoomIn_Click"/>
                    <MenuFlyoutItem Text="Pomniejsz (Ctrl+Num -)" Click="ZoomOut_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Otwórz lokalizację w Eksploratorze" Click="Explorer_Click"/>
                    <MenuFlyoutItem Text="Kopiuj ścieżkę" Click="CopyPath_Click"/>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailsPaneColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" x:Name="ZoomScroll" Background="Transparent"
                          SizeChanged="ZoomScroll_SizeChanged"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="10"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ViewChanged="ZoomScroll_ViewChanged">
                <Image x:Name="FullImage" Stretch="Fill"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ScrollViewer>
            <ProgressRing Grid.Column="0" x:Name="LoadingIndicator" Width="52" Height="52"
                          IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="0" x:Name="ImageMessage" Foreground="White" FontSize="13"
                       TextAlignment="Center" TextWrapping="Wrap"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Margin="20" MaxWidth="800"/>
            <Grid Grid.Column="0" Width="46" HorizontalAlignment="Left" Background="Transparent"
                  PointerEntered="PreviousPointerEntered" PointerExited="PreviousPointerExited">
                <Button x:Name="PreviousButton" Content="❮" FontSize="18"
                        Width="34" Height="50" Opacity="0" CornerRadius="7"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="Previous_Click"/>
            </Grid>
            <Grid Grid.Column="0" Width="46" HorizontalAlignment="Right" Background="Transparent"
                  PointerEntered="NextPointerEntered" PointerExited="NextPointerExited">
                <Button x:Name="NextButton" Content="❯" FontSize="18"
                        Width="34" Height="50" Opacity="0" CornerRadius="7"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="Next_Click"/>
            </Grid>
            <!-- Details take their own column; the image re-fits to the remaining width. -->
        <Border x:Name="DetailsPane" Grid.Column="1" Width="290"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Background="#F0202228" BorderBrush="#4D5057" BorderThickness="1,0,0,0"
                Visibility="Collapsed" Padding="16">
            <StackPanel Spacing="11">
                <TextBlock Text="Szczegóły" FontWeight="SemiBold" FontSize="17"/>
                <TextBlock x:Name="DetailsNameText" Text="" FontWeight="SemiBold"
                           TextWrapping="WrapWholeWords"/>
                <TextBlock x:Name="DetailsTypeText" Text="" FontSize="12"/>
                <TextBlock x:Name="DetailsSizeText" Text="" FontSize="12"/>
                <TextBlock x:Name="DetailsDimensionsText" Text="" FontSize="12"/>
                <TextBlock x:Name="DetailsRatingText" Text="" FontSize="12"/>
                <TextBlock x:Name="DetailsPathText" Text="" TextWrapping="WrapWholeWords"
                           FontSize="11" Foreground="#B7BEC7"/>
            </StackPanel>
        </Border>
        </Grid>

        <Grid Grid.Row="3" Background="#202226" Padding="8,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14"
                        VerticalAlignment="Center" Margin="3,0,9,0">
                <TextBlock x:Name="Status" Text="— px · JPG"
                           FontSize="13" Foreground="#E8EDF2"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="FileSizeLabel" Text="" FontSize="12"
                           Foreground="#9FA9B6" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="ZoomModeButton" Content="Dopasuj"
                    Click="ZoomModeButton_Click" Padding="8,0" Height="28" MinHeight="0"
                    ToolTipService.ToolTip="Przełącz między dopasowaniem do okna i 100% oryginału"/>
            <Button Grid.Column="2" Content="−" FontSize="17" Click="ZoomOut_Click"
                    Padding="7,0" Height="28" MinHeight="0"/>
            <TextBlock Grid.Column="3" x:Name="ZoomLabel" Text="—"
                       FontSize="11" Foreground="White" Width="48"
                       VerticalAlignment="Center" TextAlignment="Center"/>
            <Slider Grid.Column="4" x:Name="ZoomSlider" Minimum="5" Maximum="500"
                    StepFrequency="1" Value="100" VerticalAlignment="Center"
                    Height="28" MinHeight="0"
                    ValueChanged="ZoomSlider_ValueChanged"
                    AutomationProperties.Name="Powiększenie w procentach oryginalnego obrazu"/>
            <Button Grid.Column="5" Content="+" FontSize="17" Click="ZoomIn_Click"
                    Padding="7,0" Height="28" MinHeight="0"/>
        </Grid>

        <Border Grid.Row="2" x:Name="FilmstripBorder" Background="#202226"
                Padding="5,2">
            <Grid>
                <ListView x:Name="Filmstrip" Height="82" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="Filmstrip_ItemClick"
                          ContainerContentChanging="Filmstrip_ContainerContentChanging"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="86" Height="75" Margin="1">
                                <Border Background="#32353A" CornerRadius="6"/>
                                <Image Source="{Binding Thumbnail}" Width="84" Height="73"
                                       Stretch="UniformToFill"/>
                                <Border BorderBrush="#67BDF5" BorderThickness="2" CornerRadius="4"
                                        Opacity="{Binding SelectionOpacity}" IsHitTestVisible="False"/>
                                <TextBlock Text="{Binding TypeMark}" HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" Foreground="White" Margin="4"/>
                                <TextBlock Text="{Binding Heart}" HorizontalAlignment="Right"
                                           VerticalAlignment="Top" Foreground="IndianRed" Margin="3"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="▾" Click="FilmstripToggle_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="32" Height="25" Padding="0" Opacity="0.5"
                        ToolTipService.ToolTip="Ukryj pasek miniaturek (F)"/>
            </Grid>
        </Border>

    </Grid>
</Window>
