<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FluentMediaGallery.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentMediaGallery">
    <Grid x:Name="LayoutRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="200" MaxWidth="500"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Photos-inspired title chrome: brand left, one central search,
             compact actions right and native Windows caption buttons. -->
        <Grid Grid.Row="0" Grid.ColumnSpan="4" Background="#202123" ColumnSpacing="5"
              Padding="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="144"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="MainTitleDragRegion" Grid.Column="0" Background="Transparent"
                  Padding="7,0">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A5;" FontSize="17" Foreground="#83CBF7"/>
                    <TextBlock Text="FluentMediaGallery" FontSize="13"
                               Foreground="#DDE1E5" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <TextBox x:Name="SearchBox" Grid.Column="1"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Width="500" MaxWidth="500" MinWidth="140" Height="30"
                     FontSize="12" Margin="4,0"
                     PlaceholderText="Szukaj w bibliotece"
                     KeyDown="SearchBox_KeyDown"/>
            <Button Grid.Column="2" Content="♡ Ulubione" Click="TitleFavorites_Click"
                    Height="28" Padding="12,2" FontSize="12"
                    ToolTipService.ToolTip="Pokaż ulubione"/>
            <Button Grid.Column="3" Click="BrowseSource_Click"
                    Height="28" Padding="9,2" FontSize="12"
                    ToolTipService.ToolTip="Dodaj folder">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE8B7;" FontSize="15"/>
                    <FontIcon Glyph="&#xE710;" FontSize="10"/>
                </StackPanel>
            </Button>
        </Grid>
        <Border x:Name="SidebarGrip" Grid.Row="1" Grid.Column="1" Background="#35383D"
                PointerPressed="SidebarGrip_PointerPressed"
                PointerMoved="SidebarGrip_PointerMoved"
                PointerReleased="SidebarGrip_PointerReleased"
                ToolTipService.ToolTip="Przeciągnij, aby zmienić szerokość panelu"/>
        <!-- Sources are user-selected only; no automatic Pictures/SMB discovery. -->
        <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,1,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid Padding="9,9,9,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Spacing="1" Margin="0,1,0,4">
                    <TextBlock Text="Biblioteka" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Row="1" Content="▧  Galeria" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Click="AllSources_Click"
                        Margin="0,0,0,6" FontSize="12" Padding="9,6"/>
                <Button Grid.Row="2" Content="♥  Ulubione"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="SidebarFavorites_Click" FontSize="12"
                        Padding="9,6" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="3" Text="Wybrane foldery" FontSize="12"
                           FontWeight="SemiBold" Margin="3,6,0,5"/>
                <!-- Lazy, SQLite-backed folder navigation; no recursive file system access. -->
                <ListView Grid.Row="4" x:Name="SourceItems" IsItemClickEnabled="True"
                          ItemClick="SourceItems_ItemClick" SelectionMode="None"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                            <RepositionThemeTransition IsStaggeringEnabled="False"/>
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding Indent}" Padding="2,1" MinHeight="27">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Content="{Binding Chevron}"
                                        Tag="{Binding}" Click="FolderToggle_Click"
                                        Padding="2" FontSize="12" BorderThickness="0"
                                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                        Background="Transparent"/>
                                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="13"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="10"
                                               Visibility="{Binding StatusVisibility}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="5" Spacing="5" Margin="0,6,0,2">
                    <TextBlock Text="Dodaj lokalizację" FontSize="12" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SourcePath" Grid.Column="0"
                                 PlaceholderText="C:\Zdjęcia lub \\NAS\Udział\Media"
                                 TextWrapping="NoWrap"/>
                        <Button x:Name="BrowseSourceButton" Grid.Column="1"
                                Click="BrowseSource_Click" ToolTipService.ToolTip="Wybierz folder"
                                AutomationProperties.Name="Wybierz folder do biblioteki">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button x:Name="AddSourceButton" Content="Dodaj wskazaną lokalizację"
                            HorizontalAlignment="Stretch" Click="AddSource_Click"/>
                    <TextBlock Text="Indeksowane są tylko wybrane lokalizacje."
                               FontSize="10" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main pane always reads a bounded SQLite page. -->
        <Grid Grid.Row="1" Grid.Column="2" Padding="24,15,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,2,0,16">
                <TextBlock x:Name="HeaderTitle" Text="Wszystkie media" FontSize="22"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="LibrarySummary" Text="Ładowanie biblioteki..."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,9" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Zdjęcia i filmy"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <CheckBox x:Name="FavoritesOnly" Grid.Column="1" Content="Ulubione"
                          Checked="FavoritesOnly_Changed" Unchecked="FavoritesOnly_Changed"
                          VerticalAlignment="Center"/>
                <Button x:Name="SortButton" Grid.Column="2" MinWidth="170"
                        Content="Sortuj: Modyfikacja ↓" Height="30" FontSize="12">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Tag="modified" Text="Modyfikacja"
                                            Click="SortField_Click"/>
                            <MenuFlyoutItem Tag="created" Text="Utworzenie"
                                            Click="SortField_Click"/>
                            <MenuFlyoutItem Tag="name" Text="Nazwa"
                                            Click="SortField_Click"/>
                            <MenuFlyoutItem Tag="rating" Text="Klasyfikacja"
                                            Click="SortField_Click"/>
                            <MenuFlyoutItem Tag="favorites" Text="Ulubione"
                                            Click="SortField_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Tag="asc" Text="↑ Rosnąco"
                                            Click="SortDirection_Click"/>
                            <MenuFlyoutItem Tag="desc" Text="↓ Malejąco"
                                            Click="SortDirection_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <ComboBox x:Name="ViewModeBox" Grid.Column="3" MinWidth="120"
                          PlaceholderText="Widok" Height="30" FontSize="12"
                          SelectionChanged="ViewModeBox_SelectionChanged">
                    <ComboBoxItem Tag="square" Content="Kwadrat"/>
                    <ComboBoxItem Tag="river" Content="Rzeka (beta)"/>
                </ComboBox>
                <Button Grid.Column="4" Content="Odśwież" Height="30" FontSize="12"
                        Click="Refresh_Click"/>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                <Button x:Name="ScanButton" Content="Indeksuj wybrany folder"
                        Click="Scan_Click"/>
                <Button x:Name="RatingButton" Content="Odczytaj klasyfikacje"
                        Click="ImportRatings_Click"/>
                <Button x:Name="CancelButton" Content="Anuluj"
                        IsEnabled="False" Click="Cancel_Click"/>
            </StackPanel>
            <!-- Both views share lazy SQLite batches; no full library materialization at startup. -->
            <Grid Grid.Row="3" ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="66"/>
                </Grid.ColumnDefinitions>
            <GridView Grid.Column="0" x:Name="MediaItems" Loaded="MediaItems_Loaded"
                      SizeChanged="MediaItems_SizeChanged" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="MediaItems_ItemClick"
                      ContainerContentChanging="MediaItems_ContainerContentChanging"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="184" ItemHeight="202"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Height="192" Padding="5" Margin="3" CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="142"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <TextBlock Text="{Binding TypeMark}" FontSize="40" Opacity="0.2"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch" Height="142"/>
                                    <Border Background="#AA202020" CornerRadius="4" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" Margin="4" Padding="5,2">
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding Heart}" Foreground="IndianRed" FontSize="23"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"/>
                                </Grid>
                                <StackPanel Grid.Row="1" Spacing="2" Margin="3,5,3,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding SizeText}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <!-- Justified rows with widths derived from original media aspect ratio. -->
            <ListView Grid.Column="0" x:Name="RiverItems"
                      Visibility="Collapsed" Loaded="RiverItems_Loaded"
                      SizeChanged="RiverItems_SizeChanged"
                      ContainerContentChanging="RiverItems_ContainerContentChanging"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="0" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Header}" Visibility="{Binding HeaderVisibility}"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="3,5,0,8"/>
                            <ItemsControl ItemsSource="{Binding Tiles}"
                                          Width="{Binding CanvasWidth}"
                                          Height="{Binding CanvasHeight}"
                                          HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="RiverTile_Click" Tag="{Binding Media}"
                                                Width="{Binding Width}" Height="{Binding Height}"
                                                Margin="0" Padding="0" BorderThickness="0"
                                                CornerRadius="3" Background="Transparent">
                                            <Button.RenderTransform>
                                                <TranslateTransform X="{Binding Left}" Y="{Binding Top}"/>
                                            </Button.RenderTransform>
                                            <Grid Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                                  Background="#484C51">
                                                <Image Source="{Binding Media.Thumbnail}"
                                                       Stretch="UniformToFill"/>
                                                <TextBlock Text="{Binding Media.Heart}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                                           FontSize="19" Foreground="IndianRed" Margin="4"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- A non-interactive skeleton appears instantly for long SQLite seeks.
                 Actual image slots stay light gray while Shell thumbnails decode. -->
            <Grid x:Name="GalleryLoadingOverlay" Grid.Column="0"
                  Visibility="Collapsed" IsHitTestVisible="False"
                  Background="#202226">
                <Grid.RowDefinitions>
                    <RowDefinition Height="178"/>
                    <RowDefinition Height="178"/>
                    <RowDefinition Height="178"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Background="#454A4E" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="0" Grid.Column="1" Background="#393E43" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="0" Grid.Column="2" Background="#454A4E" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="0" Grid.Column="3" Background="#393E43" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="1" Grid.Column="0" Background="#393E43" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="1" Grid.Column="1" Background="#454A4E" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="1" Grid.Column="2" Background="#393E43" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="1" Grid.Column="3" Background="#454A4E" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="2" Grid.Column="0" Background="#454A4E" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="2" Grid.Column="1" Background="#393E43" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="2" Grid.Column="2" Background="#454A4E" Margin="2" CornerRadius="4"/>
                <Border Grid.Row="2" Grid.Column="3" Background="#393E43" Margin="2" CornerRadius="4"/>
            </Grid>
            <!-- One Photos-style date rail; the inner list's OS scrollbar is hidden.
                 Drag/click this track for calendar seek, not for scroll position guesswork. -->
            <Grid Grid.Column="1" x:Name="TimelineTrack" Background="Transparent"
                  PointerPressed="TimelineTrack_PointerPressed"
                  PointerMoved="TimelineTrack_PointerMoved"
                  PointerReleased="TimelineTrack_PointerReleased"
                  PointerCaptureLost="TimelineTrack_PointerCaptureLost"
                  SizeChanged="TimelineTrack_SizeChanged"
                  ToolTipService.ToolTip="Przeciągnij kreskę, aby przejść do daty">
                <Canvas x:Name="TimelineMarks" IsHitTestVisible="False"/>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="TimelineThumb" Width="29" Height="3"
                            CornerRadius="1.5" Background="#79D8FF"
                            Canvas.Left="30" Canvas.Top="12"/>
                    <Border x:Name="TimelineBubble" Background="#34383E"
                            CornerRadius="3" Padding="4,3" Visibility="Collapsed"
                            Canvas.Left="-37" Canvas.Top="12">
                        <TextBlock x:Name="TimelineValue" Text="—" FontSize="10"
                                   Foreground="White" TextAlignment="Center"
                                   MaxWidth="85" TextWrapping="Wrap"/>
                    </Border>
                </Canvas>
            </Grid>
            </Grid>
            <TextBlock Grid.Row="4" x:Name="PageLabel" Margin="3,7,0,0"
                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Row="5" Spacing="4" Margin="0,14,0,3">
                <ProgressBar x:Name="ScanProgress" IsIndeterminate="False" Value="0" Maximum="100"/>
                <TextBlock x:Name="OperationStatus" Text="Gotowe."
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.Column="3" Visibility="Collapsed" BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Padding="18" Spacing="14">
                <TextBlock Text="Szczegóły" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="DetailsName" Text="Wybierz zdjęcie lub film" FontSize="16"
                           TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock x:Name="DetailsPath" Text="Ścieżka pojawi się po wybraniu elementu."
                           FontSize="12" TextWrapping="WrapWholeWords"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="DetailsRating" Text="Klasyfikacja: —"/>
                <Button x:Name="FavoriteButton" Content="Dodaj do ulubionych"
                        Click="Favorite_Click" IsEnabled="False"
                        HorizontalAlignment="Stretch"/>
                <TextBlock Text="Zmiana ulubionych próbuje zapisać System.Rating w pliku."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="FavoriteStatus" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="To pierwszy interfejs indeksu. Miniaturki, pełny podgląd i odtwarzacz wideo są kolejnymi etapami."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
    
        <!-- In-window photo viewer. Nothing is loaded until a tile is opened. -->
        <Grid x:Name="ViewerOverlay" Grid.Row="1" Grid.ColumnSpan="4" Visibility="Collapsed"
              Background="#111315">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="122"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="16,10" Background="#202226">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ViewerCloseButton"
                        Content="← Galeria" Click="ViewerClose_Click"
                        Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="ViewerFileName" Text="Podgląd zdjęcia"
                               FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"
                               Foreground="White"/>
                    <TextBlock x:Name="ViewerPosition" Text=""
                               FontSize="11" Foreground="#BBC5CC"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="ViewerFavoriteButton"
                        Content="♡ Dodaj do ulubionych" Click="ViewerFavorite_Click"
                        Margin="0,0,10,0"/>
                <Button Grid.Column="3" Content="Zamknij (Esc)" Click="ViewerClose_Click"/>
            </Grid>

            <Grid Grid.Row="1" Padding="15,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ViewerPreviousButton"
                        Content="❮" Click="ViewerPrevious_Click"
                        FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Margin="0,0,8,0"/>
                <Grid Grid.Column="1">
                    <Image x:Name="ViewerImage" Stretch="Uniform"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <ProgressRing x:Name="ViewerLoading" IsActive="False" Width="48" Height="48"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ViewerStatus" Text="" Foreground="#E8E8E8"
                               FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="720"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Margin="16,0,16,14"/>
                </Grid>
                <Button Grid.Column="2" x:Name="ViewerNextButton"
                        Content="❯" Click="ViewerNext_Click"
                        FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Margin="8,0,0,0"/>
            </Grid>

            <Border Grid.Row="2" Background="#202226" Padding="10,8">
                <!-- Filmstrip reuses thumbnails in the current 100-row SQLite page. -->
                <ListView x:Name="ViewerFilmstrip" Height="100"
                          SelectionMode="Single"
                          SelectionChanged="ViewerFilmstrip_SelectionChanged"
                          ContainerContentChanging="ViewerFilmstrip_ContainerContentChanging"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="103" Height="80" Margin="2">
                                <Border Background="#32353A" CornerRadius="5"/>
                                <Image Source="{Binding Thumbnail}" Width="100" Height="77"
                                       Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding TypeMark}" FontSize="14"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                           Foreground="White" Margin="3"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>
